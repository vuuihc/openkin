    "old": "    print(\"MUTANT_EVIDENCE_MISSING: \" + \", \".join(missing))\n    sys.exit(1)",
    "new": "    print(\"MUTANT_EVIDENCE_SKIP: no loop-code change\")\n    sys.exit(0)"
  },
  {
    "label": "mutants.py's exit code is ignored, so a surviving mutant looks proven",
    "file": "rsi/runtime/lane.sh",
    "test": "RSI_TEST_ONLY=case_surviving_mutant_fails_and_restores bash rsi/runtime/tests/test-lane-mutants.sh",
    "old": "    if proc.returncode == 0:\n        continue",
    "new": "    if True:\n        continue"
  },
  {
    "label": "any manifest entry counts, whatever file it names",
    "file": "rsi/runtime/lane.sh",
    "test": "RSI_TEST_ONLY=case_manifest_entry_for_another_file_does_not_count bash rsi/runtime/tests/test-lane-mutants.sh",
    "old": "        by_file.setdefault(f[2:] if f.startswith(\"./\") else f, set()).add(m)",
    "new": "        by_file.setdefault(changed[0], set()).add(m)"
  },
  {
    "label": "a malformed manifest is skipped instead of failing closed",
    "file": "rsi/runtime/lane.sh",
    "test": "RSI_TEST_ONLY=case_invalid_manifest_fails_closed bash rsi/runtime/tests/test-lane-mutants.sh",
    "old": "    except Exception:\n        broken.append(m)\n        continue",
    "new": "    except Exception:\n        continue"
  },
  {
