    "old": "      | grep -E '^(rsi/runtime|scripts)/.*\\.(sh|bash|py|mjs|js|ts)$' \\",
    "new": "      | grep -E '^rsi/runtime/.*\\.(sh|bash|py|mjs|js|ts)$' \\"
  },
  {
    "label": "an unreadable branch point is read as no loop change",
    "file": "rsi/runtime/lane.sh",
    "test": "RSI_TEST_ONLY=case_unresolvable_origin_main_fails_closed bash rsi/runtime/tests/test-lane-mutants.sh",
    "old": "  \"$GIT\" -C \"$wt\" rev-parse --verify -q origin/main >/dev/null 2>&1 \\\n    || { echo \"MUTANT_EVIDENCE_RED: $wt · origin/main is not resolvable\"; return 1; }\n  base=\"$(\"$GIT\" -C \"$wt\" merge-base origin/main HEAD 2>/dev/null)\" \\\n    || { echo \"MUTANT_EVIDENCE_RED: $wt · origin/main and HEAD have no merge base\"; return 1; }",
    "new": "  base=\"\""
  },
  {
    "label": "the lane ignores a red verdict and pushes anyway",
    "file": "rsi/runtime/lane.sh",
    "test": "RSI_TEST_ONLY=case_lane_runs_check_before_push bash rsi/runtime/tests/test-lane-mutants.sh",
    "old": "if ! MUT_EV=\"$(bash \"$SELF\" --mutant-evidence-check \"$WT\" 2>&1)\"; then",
    "new": "if ! MUT_EV=\"$(bash \"$SELF\" --mutant-evidence-check \"$WT\" 2>&1 || true)\"; then"
  },
  {
    "label": "a deleted loop file is demanded as evidence, so a cleanup cannot land",
    "file": "rsi/runtime/lane.sh",
    "test": "RSI_TEST_ONLY=case_deleted_loop_file_needs_no_manifest bash rsi/runtime/tests/test-lane-mutants.sh",
    "old": "\"$GIT\" -C \"$wt\" diff --name-only --diff-filter=d \"$base\" 2>/dev/null",
    "new": "\"$GIT\" -C \"$wt\" diff --name-only \"$base\" 2>/dev/null"
  },
  {
    "label": "the changed set follows a moved origin/main, charging other lanes' merges to this lane",
    "file": "rsi/runtime/lane.sh",
    "test": "RSI_TEST_ONLY=case_origin_main_advance_does_not_add_files bash rsi/runtime/tests/test-lane-mutants.sh",
    "old": "\"$GIT\" -C \"$wt\" diff --name-only --diff-filter=d \"$base\" 2>/dev/null",
    "new": "\"$GIT\" -C \"$wt\" diff --name-only --diff-filter=d origin/main 2>/dev/null"
  },
  {
    "label": "a manifest already on main covers a new edit, so its new guard needs no proof",
    "file": "rsi/runtime/lane.sh",
    "test": "RSI_TEST_ONLY=case_preexisting_manifest_does_not_cover_new_edit bash rsi/runtime/tests/test-lane-mutants.sh",
    "old": "  manifests=\"$(\n    { \"$GIT\" -C \"$wt\" diff --name-only --diff-filter=d \"$base\" -- '*.mutants.json' 2>/dev/null\n      \"$GIT\" -C \"$wt\" ls-files --others --exclude-standard -- '*.mutants.json' 2>/dev/null\n    } | LC_ALL=C sort -u\n  )\"",
    "new": "  manifests=\"$(\"$GIT\" -C \"$wt\" ls-files -co --exclude-standard -- '*.mutants.json' 2>/dev/null | LC_ALL=C sort -u)\""
  },
