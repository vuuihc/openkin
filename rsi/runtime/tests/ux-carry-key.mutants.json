    "test": "RSI_TEST_ONLY=test_a_css_move_regates bash rsi/runtime/tests/test-ux-carry-key.sh",
    "old": "      | grep -vE '(\\.(test|spec)\\.[^/]+$|/__tests__/|/test/|\\.mutants\\.json$|\\.md$)'\n",
