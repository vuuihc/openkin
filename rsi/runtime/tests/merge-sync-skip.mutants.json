[
  {
    "label": "the disjoint hold never holds (green CI always syncs), so the skip buys nothing",
    "file": "rsi/runtime/merge.sh",
    "test": "RSI_TEST_ONLY=test_pass_disjoint_move_holds bash rsi/runtime/tests/test-merge-sync-skip.sh",
    "old": "      CARRY|CARRY-UI|CARRY-RN|CARRY-UI-RN)",
    "new": "      NEVER)"
  },
  {
    "label": "the disjoint hold ignores the gate cache, so a gate verified on another head is trusted",
    "file": "rsi/runtime/merge.sh",
    "test": "RSI_TEST_ONLY=test_pass_no_gate_cache_syncs bash rsi/runtime/tests/test-merge-sync-skip.sh",
    "old": "  if [ \"$gsha\" != \"$hd\" ] || [ \"$gpass\" != PASS ]; then",
    "new": "  if false; then"
  },
  {
    "label": "the CI hold ignores ui-leaf moves (CARRY-UI), so a ui move still cancels the green run",
    "file": "rsi/runtime/merge.sh",
    "test": "RSI_TEST_ONLY=test_pass_ui_leaf_move_holds bash rsi/runtime/tests/test-merge-sync-skip.sh",
    "old": "      CARRY|CARRY-UI|CARRY-RN|CARRY-UI-RN)",
    "new": "      CARRY)"
  },
  {
    "label": "the CI hold ignores RN-leaf moves (CARRY-RN), so an RN move still cancels the green run",
    "file": "rsi/runtime/merge.sh",
    "test": "RSI_TEST_ONLY=test_pass_rn_leaf_move_holds bash rsi/runtime/tests/test-merge-sync-skip.sh",
    "old": "      CARRY|CARRY-UI|CARRY-RN|CARRY-UI-RN)",
    "new": "      CARRY|CARRY-UI)"
  },
  {
    "label": "the step-1 call site inverts the decision, so a HOLD syncs and a SYNC is held",
    "file": "rsi/runtime/merge.sh",
    "test": "RSI_TEST_ONLY=test_call_site_branches_on_the_decision bash rsi/runtime/tests/test-merge-sync-skip.sh",
