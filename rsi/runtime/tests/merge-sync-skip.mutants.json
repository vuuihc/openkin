    "new": "if [ $CI_FIRST_RC -ne 0 ]; then"
  },
  {
    "label": "a held start that merges in the land loop leaves no land-sync line, so the retro cannot tell it from a real skip",
    "file": "rsi/runtime/merge.sh",
    "test": "RSI_TEST_ONLY=test_wiring_shares_classifier_and_logs_decision bash rsi/runtime/tests/test-merge-sync-skip.sh",
    "old": "  echo \"$(date '+%F %H:%M') #$N $SLUG sync_decision=land-sync after=$CI_FIRST_KIND\" >> \"$STATE/merge/cycles.log\"",
