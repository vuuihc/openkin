<plist version="1.0"><dict>
  <key>Label</key><string>com.ethan.kin-rsi-nas</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__CTRL__/rsi/runtime/nas/pulse-nas.sh</string></array>
