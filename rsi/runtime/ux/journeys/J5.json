{
  "title": "Manage a chat: row actions (pin / rename / archive / delete)",
  "viewports": [
    "phone",
    "mac"
  ],
  "steps": [
    [
      "goto",
      "/sessions"
    ],
    [
      "click",
      "?css=section:has-text('[seed] Project Gamma'):not(:has(section)) button[aria-label^='展开项目'], section:has-text('[seed] Project Gamma'):not(:has(section)) button[aria-label^='Expand project']"
    ],
    [
      "wait",
      "css=[data-row-actions][aria-describedby='session-row-title-{j5.conversation}']"
    ],
    [
      "hover",
      "css=[data-row-actions][aria-describedby='session-row-title-{j5.conversation}']"
    ],
    [
      "shot",
      "row-hover"
    ],
    [
      "click",
      "css=[data-row-actions][aria-describedby='session-row-title-{j5.conversation}']"
    ],
    [
      "wait",
      "css=[role=menuitem]:has-text('改名'), [role=menuitem]:has-text('Rename'), button:has-text('改名'), button:has-text('Rename')"
    ],
    [
      "wait",
      "css=[role=menuitem]:has-text('置顶'), [role=menuitem]:has-text('Pin'), button:has-text('置顶'), button:has-text('Pin')"
    ],
    [
      "wait",
      "css=[role=menuitem]:has-text('归档'), [role=menuitem]:has-text('Archive'), button:has-text('归档'), button:has-text('Archive')"
    ],
    [
      "wait",
      "css=[role=menuitem]:has-text('删除'), [role=menuitem]:has-text('Delete'), button:has-text('删除'), button:has-text('Delete')"
    ],
    [
      "count",
      "css=[role=menuitem][aria-disabled='true']:has-text('运行中'), [role=menuitem][aria-disabled='true']:has-text('Running'), button[disabled]:has-text('运行中'), button[disabled]:has-text('Running')",
      "1"
    ],
    [
      "shot",
      "row-actions"
    ]
  ]
}
