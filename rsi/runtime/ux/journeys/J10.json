{
  "title": "Phone: approve a notification's card, visit all four footer entries, and come back to it still gone",
  "viewports": [
    "phone"
  ],
  "steps": [
    [
      "goto",
      "/sessions"
    ],
    [
      "goto",
      "/tasks/{conversation}?focus={focus}"
    ],
    [
      "wait",
      "css=[data-pending-id=\"{focus}\"]"
    ],
    [
      "shot",
      "f5-deep-link"
    ],
    [
      "click",
      "[data-pending-id=\"{focus}\"] button[aria-label='批准'], [data-pending-id=\"{focus}\"] button[aria-label='Approve']"
    ],
    [
      "gone",
      "[data-pending-id=\"{focus}\"] button[aria-label='批准'], [data-pending-id=\"{focus}\"] button[aria-label='Approve']"
    ],
    [
      "shot",
      "f5-approved"
    ],
    [
      "back"
    ],
    [
      "url",
      "^/sessions"
    ],
    [
      "click",
      "[data-phone-return=\"settings\"]"
    ],
    [
      "url",
      "^/settings$"
    ],
    [
      "search",
      "^$"
    ],
    [
      "goto",
      "/settings?tab=agents"
    ],
    [
      "url",
      "^/settings$"
    ],
    [
      "search",
      "tab=agents"
    ],
    [
      "click",
      "[data-phone-return=\"agents\"]"
    ],
    [
      "url",
      "^/settings$"
    ],
    [
      "search",
      "tab=operations"
    ],
    [
      "click",
      "[data-phone-return=\"settings\"]"
    ],
    [
      "url",
      "^/settings$"
    ],
    [
      "search",
      "tab=agents"
    ],
    [
      "shot",
      "f5-tab-settings-remembered"
    ],
    [
      "click",
      "[data-phone-return=\"routines\"]"
    ],
    [
      "url",
      "^/routines"
    ],
    [
      "shot",
      "f5-tab-routines"
    ],
    [
      "click",
      "[data-phone-return=\"sessions\"]"
    ],
    [
      "url",
      "^/sessions"
    ],
    [
      "click",
      "?/Search chats|搜索对话/"
    ],
    [
      "fill",
      "?input[type=search]",
      "deploy"
    ],
    [
      "wait",
      "css=[data-session-row=\"{conversation}\"]"
    ],
    [
      "click",
      "[data-session-row=\"{conversation}\"]"
    ],
    [
      "url",
      "^/tasks/{conversation}"
    ],
    [
      "wait",
      "css=[role=region][tabindex='-1']"
    ],
    [
      "gone",
      "[data-pending-id=\"{focus}\"] button[aria-label='批准'], [data-pending-id=\"{focus}\"] button[aria-label='Approve']"
    ],
    [
      "count",
      "css=[data-pending-id=\"{focus}\"] button[aria-label='批准'], [data-pending-id=\"{focus}\"] button[aria-label='Approve']",
      "0"
    ],
    [
      "shot",
      "f5-approved-card-stayed-gone"
    ]
  ]
}
