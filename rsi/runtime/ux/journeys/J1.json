{
  "title": "Phone: find last week's chat, approve one card and deny another; search and filter the list",
  "viewports": [
    "phone"
  ],
  "steps": [
    [
      "goto",
      "/sessions"
    ],
    [
      "shot",
      "list"
    ],
    [
      "fill",
      "?input[type=search]",
      "week"
    ],
    [
      "shot",
      "search"
    ],
    [
      "click",
      "?/筛选|Filter/"
    ],
    [
      "shot",
      "filters"
    ],
    [
      "key",
      "Escape"
    ],
    [
      "goto",
      "/tasks/{approve.conversation}?focus={approve.focus}"
    ],
    [
      "shot",
      "approval-card"
    ],
    [
      "click",
      "[role=region][aria-label='对话'] button[aria-label='批准'], [role=region][aria-label='Conversation'] button[aria-label='Approve']"
    ],
    [
      "gone",
      "[role=region][aria-label='对话'] button[aria-label='批准'], [role=region][aria-label='Conversation'] button[aria-label='Approve']"
    ],
    [
      "shot",
      "approved"
    ],
    [
      "key",
      "Tab"
    ],
    [
      "shot",
      "conversation-focus"
    ],
    [
      "goto",
      "/tasks/{deny.conversation}?focus={deny.focus}"
    ],
    [
      "shot",
      "deny-card"
    ],
    [
      "click",
      "[role=region][aria-label='对话'] button[aria-label='拒绝'], [role=region][aria-label='Conversation'] button[aria-label='Deny']"
    ],
    [
      "gone",
      "[role=region][aria-label='对话'] button[aria-label='拒绝'], [role=region][aria-label='Conversation'] button[aria-label='Deny']"
    ],
    [
      "shot",
      "denied"
    ]
  ]
}
