{
  "title": "Phone: find last week's chat, approve one card and deny another; search and filter the list",
  "viewports": [
    "phone"
  ],
  "steps": [
    [
      "goto",
      "/sessions"
    ],
    [
      "shot",
      "list"
    ],
    [
      "click",
      "?/Search chats|搜索对话/"
    ],
    [
      "fill",
      "?input[type=search]",
      "Morning"
    ],
    [
      "shot",
      "search"
    ],
    [
      "click",
      "?/筛选|Filter/"
    ],
    [
      "shot",
      "filters"
    ],
    [
      "key",
      "Escape"
    ],
    [
      "wait",
      "css=[data-session-row]:has-text(\"[seed] Morning planning\")"
    ],
    [
      "shot",
      "search-open"
    ],
    [
      "click",
      "css=[data-session-row]:has-text('[seed] Morning planning')"
    ],
    [
      "url",
      "^/tasks/"
    ],
    [
      "shot",
      "search-open-card"
    ],
    [
      "back"
    ],
    [
      "url",
      "^/sessions"
    ],
    [
      "value",
      "input[type=search]",
      "Morning"
    ],
    [
      "search",
      "search=Morning"
    ],
    [
      "wait",
      "css=[data-session-row]:has-text(\"[seed] Morning planning\")"
    ],
    [
      "shot",
      "search-back"
    ],
    [
      "goto",
      "/tasks/{approve.conversation}?focus={approve.focus}"
    ],
    [
      "shot",
      "approval-card"
    ],
    [
      "click",
      "[role=region][aria-label='对话'] button[aria-label='批准'], [role=region][aria-label='Conversation'] button[aria-label='Approve']"
    ],
    [
      "gone",
      "[role=region][aria-label='对话'] button[aria-label='批准'], [role=region][aria-label='Conversation'] button[aria-label='Approve']"
    ],
    [
      "shot",
      "approved"
    ],
    [
      "key",
      "Tab"
    ],
    [
      "shot",
      "conversation-focus"
    ],
    [
      "goto",
      "/tasks/{deny.conversation}?focus={deny.focus}"
    ],
    [
      "shot",
      "deny-card"
    ],
    [
      "click",
      "[role=region][aria-label='对话'] button[aria-label='拒绝'], [role=region][aria-label='Conversation'] button[aria-label='Deny']"
    ],
    [
      "gone",
      "[role=region][aria-label='对话'] button[aria-label='拒绝'], [role=region][aria-label='Conversation'] button[aria-label='Deny']"
    ],
    [
      "shot",
      "denied"
    ]
  ]
}
