    ["swipe", 12, 140, 420, 260],
    ["url", "^/sessions"],
    ["value", "input[type=search]", "seed"],
    ["scroll-kept", "css=[data-phone-scroll]", "80"],
    ["shot", "list-restored"],

    ["goto", "/sessions"],
    ["wait", "css=[data-session-row]:has-text(\"[seed] Morning planning\")"],
    ["shot", "row-closed"],
    ["swipe", 330, 100, "css=[data-session-row]:has-text(\"[seed] Morning planning\")", 260],
    ["wait", "css=button[aria-label='置顶'], button[aria-label='Pin']"],
    ["wait", "css=button[aria-label='归档'], button[aria-label='Archive']"],
