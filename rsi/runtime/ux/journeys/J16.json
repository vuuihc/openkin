{
  "title": "Tablet: read a long answer's table at 820 touch, then see the reply that landed while away",
  "viewports": [
    "tablet"
  ],
  "steps": [
    [
      "goto",
      "/new"
    ],
    [
      "fill",
      "textarea",
      "Draft the tablet reading review [seed] reading"
    ],
    [
      "place",
      "button[aria-label^='设备与项目'], button[aria-label*='Device & project'], button[aria-label*='Place'], button[aria-label*='Workspace'], button:has-text('更换'), button:has-text('Change')"
    ],
    [
      "send",
      "button[aria-label='开始'], button[aria-label='Start']"
    ],
    [
      "url",
      "^/tasks/"
    ],
    [
      "wait",
      "css=[role=region][tabindex=\"-1\"]:has-text(\"Tablet reading fixture\")"
    ],
    [
      "shot",
      "answer-top"
    ],
    [
      "scroll",
      "css=[role=region][tabindex=\"-1\"]",
      "bottom"
    ],
    [
      "reading",
      "table-bottom"
    ],
    [
      "shot",
      "answer-bottom"
    ],
    [
      "fill",
      "textarea",
      "Reading follow-up while the reader is away [seed] slow"
    ],
    [
      "send",
      "button[aria-label='发送'], button[aria-label='Send']"
    ],
    [
      "scroll",
      "css=[role=region][tabindex=\"-1\"]",
      "bottom-140"
    ],
    [
      "wait",
      "css=button:has-text('有新进展'), button:has-text('New activity')",
      "20000"
    ],
    [
      "shot",
      "incoming"
    ],
    [
      "reading",
      "incoming",
      "require-new-activity"
    ]
  ]
}
