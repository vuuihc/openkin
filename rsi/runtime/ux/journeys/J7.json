{
  "title": "Notification deep link lands on the exact card",
  "viewports": [
    "phone",
    "mac"
  ],
  "steps": [
    [
      "goto",
      "/sessions"
    ],
    [
      "goto",
      "/tasks/{conversation}?focus={focus}"
    ],
    [
      "wait",
      "css=[data-pending-id=\"{focus}\"]"
    ],
    [
      "active",
      "css=[data-pending-id=\"{focus}\"]"
    ],
    [
      "search",
      "^$"
    ],
    [
      "shot",
      "landing-card"
    ],
    [
      "back"
    ],
    [
      "url",
      "^/sessions"
    ],
    [
      "shot",
      "back-list"
    ],
    [
      "wait",
      "text={title}"
    ],
    [
      "click",
      "[data-session-row=\"{conversation}\"]"
    ],
    [
      "url",
      "^/tasks/{conversation}"
    ],
    [
      "wait",
      "css=[data-pending-id=\"{focus}\"]"
    ],
    [
      "shot",
      "back-card"
    ]
  ]
}
