{
  "title": "Notification deep link lands on the exact card",
  "viewports": [
    "phone",
    "mac"
  ],
  "steps": [
    [
      "goto",
      "/sessions"
    ],
    [
      "goto",
      "/tasks/{conversation}?focus={focus}"
    ],
    [
      "wait",
      "css=[data-pending-id=\"{focus}\"]"
    ],
    [
      "active",
      "css=[data-pending-id=\"{focus}\"]"
    ],
    [
      "search",
      "^$"
    ],
    [
      "shot",
      "landing-card"
    ],
    [
      "back"
    ],
    [
      "url",
      "^/sessions"
    ],
    [
      "shot",
      "back-list"
    ],
    [
      "vp",
      "phone"
    ],
    [
      "count",
      "css=button[aria-label='批准'], button[aria-label='Approve']",
      "0"
    ],
    [
      "vp",
      ""
    ],
    [
      "click",
      "?/Search chats|搜索对话/"
    ],
    [
      "fill",
      "?input[type=search]",
      "deploy"
    ],
    [
      "wait",
      "css=[data-session-row=\"{conversation}\"]"
    ],
    [
      "click",
      "[data-session-row=\"{conversation}\"]"
    ],
    [
      "url",
      "^/tasks/{conversation}"
    ],
    [
      "wait",
      "css=[data-pending-id=\"{focus}\"]"
    ],
    [
      "count",
      "css=[role=region][aria-label='对话'] button[aria-label='批准'], [role=region][aria-label='Conversation'] button[aria-label='Approve']",
      "1"
    ],
    [
      "shot",
      "back-card"
    ]
  ]
}
