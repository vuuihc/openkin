<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.ethan.kin-rsi-pulse</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__CTRL__/rsi/runtime/run.sh</string><string>pulse</string></array>
  <key>WorkingDirectory</key><string>__CTRL__</string>
  <key>EnvironmentVariables</key><dict><key>TZ</key><string>Asia/Singapore</string><key>HOME</key><string>__HOME__</string></dict>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__CTRL__/rsi/runtime/runs/launchd-pulse.log</string>
  <key>StandardErrorPath</key><string>__CTRL__/rsi/runtime/runs/launchd-pulse.log</string>
</dict></plist>
