#!/bin/bash
# npm shim: serialize heavy npm subcommands through heavy.sh (see runtime/heavy.sh); everything else passes straight through.
SHIM="$(cd "$(dirname "$0")" && pwd)"; HEAVY="$SHIM/../heavy.sh"
REAL="$(PATH="${PATH//$SHIM:/}" command -v npm)"
case "$1 $2" in
  "run build"|"run test"|"run typecheck"|"run lint"|"run test:ci"|"ci "|"install "|"test "|"t "|"run vitest"|"run tsc") exec "$HEAVY" "$REAL" "$@";;
  *) exec "$REAL" "$@";;
esac
