#!/bin/sh
# A fake `claude` for the UX journey walk (rsi/runtime/ux-walk.sh and
# scripts/journeys-smoke.sh). The harness puts this directory first on the
# throwaway daemon's PATH, so every conversation the seed creates runs this
# script instead of a real model turn.
#
# It speaks the same stream-json the Claude Code adapter already parses (see
# internal/adapter/claudecode/integration_test.go's writeFakeClaude): an init
# line, one assistant message, and a result line with cost and usage. The
# adapter invokes:
#
#   claude -p <prompt> --output-format stream-json --verbose ...
#
# Extra flags after the prompt (--permission-mode, --mcp-config, …) are
# ignored. A prompt containing the literal marker "[seed] fail" produces a
# result with is_error true and a non-zero exit, which the engine maps to a
# failed task.
#
# One prompt holds a turn open. A prompt containing "[seed] approve" prints
# the init line and one assistant message carrying a tool_use block, then stays
# alive instead of printing a result — so the daemon keeps the task `running`
# and scripts/journeys_seed.py can ask the daemon's own permission bridge for an
# approval row. The task then sits in `waiting_approval` and the walk
# photographs the card. It exits when its parent (the daemon) is gone, and has
# a hard cap, so a crashed walk cannot leave a sleeper behind.
#
# One prompt changes a file. A prompt containing "[seed] change" appends one
# sentinel line to the tracked notes.md, and only when the process's real
# working directory carries the `kin-journeys-seed-` prefix that
# scripts/journeys_seed.py's _seed_roots() creates — this binary can be
# selected by path, so it must never write into a real repository. The line is
# appended only once, so a re-run leaves the same one-file diff and the journey
# walk has a real workspace change to open. Every other prompt writes nothing:
# the task cwd stays untouched.
#
# Deliberately no `session_id`: a made-up ref sends the engine looking for it
# in the real agent session catalog on every turn (~16 s per seeded
# conversation on a machine with a large catalog), and a seeded conversation
# has no real session behind it. Omitting the optional field leaves the task
# succeeded in well under a second and touches no local session state.
# One prompt answers slowly. A prompt containing "[seed] slow" prints the init
# line, holds for RSI_FAKE_SLOW_SECS (default 3, clamped 0..10, a malformed
# value falls back to the default), then prints the usual reply. The J3 walk
# presses Start for real and photographs the pending bubble and the waiting
# row; without a deterministic hold that window is a race against the answer.
# The hold is bounded so a crashed walk can never leave a turn running for
# minutes, and it changes nothing for any other prompt.
set -u

prompt=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = "-p" ] && [ "$#" -ge 2 ]; then
    prompt="$2"
    break
  fi
  shift
done
if [ -z "$prompt" ]; then
  # The adapter always passes -p; only a hand-run without it reads stdin.
  prompt="$(cat)"
fi

# The seed looks for this marker in the task's events to prove which binary
# answered — a real claude never writes it.
printf 'fake-agent %s\n' "$prompt" >&2

case "$prompt" in
  *"[seed] fail"*)
    cat <<'EOF'
{"type":"system","subtype":"init","cwd":"."}
{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"The fake agent was asked to fail."}]}}
{"type":"result","subtype":"error_during_execution","is_error":true,"result":"[seed] fail: the fake agent stopped on purpose","total_cost_usd":0.00042,"usage":{"input_tokens":42,"output_tokens":7}}
EOF
    exit 1
    ;;
esac

case "$prompt" in
  *"[seed] approve"*)
    # `cat` flushes at exit; a shell builtin's printf can sit in a pipe buffer
    # while the process sleeps, and the daemon would never see these lines.
    cat <<'EOF'
{"type":"system","subtype":"init","cwd":"."}
{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_seed_approve","name":"Bash","input":{"command":"git status --short"}}]}}
EOF
    # A held turn, not a daemon of its own: die with the parent, and never
    # outlive a walk by more than the hard cap.
    i=0
    while [ "$i" -lt 600 ]; do
      kill -0 "$PPID" 2>/dev/null || exit 0
      sleep 1
      i=$((i + 1))
    done
    exit 0
    ;;
esac

# The one workspace change this fake ever makes: a single line in the tracked
# notes.md of a throwaway seed root, appended at most once.
case "$prompt" in
  *"[seed] change"*)
    # pwd -P, not an inherited $PWD: the daemon passes its own environment
    # through, so only the process's real directory proves where this writes.
    case "$(pwd -P)" in
      *kin-journeys-seed-*)
        line='- [seed] change: the journey walk reads this line as a real diff.'
        if [ -f notes.md ] && ! grep -qxF -e "$line" notes.md; then
          printf '%s\n' "$line" >>notes.md
        fi
        ;;
    esac
    ;;
esac

# Every answer begins with the init line, before any hold below. `cat` rather
# than a shell builtin's printf: the approve branch documents why a buffered
# write can sit in the pipe while the process sleeps.
cat <<'EOF'
{"type":"system","subtype":"init","cwd":"."}
EOF

case "$prompt" in
  *"[seed] slow"*)
    raw="${RSI_FAKE_SLOW_SECS:-3}"
    case "$raw" in
      '' | *[!0-9]*) secs=3 ;;
      *)
        # Compare by length first: an arbitrarily large number is not a
        # number `test -gt` has to parse.
        if [ "${#raw}" -gt 2 ] || [ "$raw" -gt 10 ]; then secs=10; else secs="$raw"; fi
        ;;
    esac
    sleep "$secs"
    ;;
esac

cat <<'EOF'
{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Fake reply"}}}
{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"Fake reply from the journey fake agent."}]}}
{"type":"result","subtype":"success","is_error":false,"result":"Fake reply from the journey fake agent.","total_cost_usd":0.00042,"usage":{"input_tokens":42,"output_tokens":7}}
EOF
exit 0
