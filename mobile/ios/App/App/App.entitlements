<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Development builds get a sandbox token, release builds a production
       token. The plugin reads the same APS_ENVIRONMENT build setting through
       KinAPNsEnvironment in Info.plist, so the token is never sent to the
       wrong APNs host. -->
  <key>aps-environment</key>
  <string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
