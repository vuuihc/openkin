# Keep the build context small and free of host artifacts.
#
# web/dist is excluded because it is its own stage's output. A clone does not
# contain the hashed bundles anyway (see .gitignore), so letting a working
# tree's stale copy in would only risk serving bundles from a different build
# than the source in this context.

.git
.gitignore

# Local state and secrets must never enter an image layer.
.env
.env.*
!.env.example
.kin-dev
*.db
*.db-shm
*.db-wal
*.pem
*.key

# Node and build output. The console stage copies ui/ on its own.
node_modules
**/node_modules
ui/dist
web/dist
desktop/dist
desktop/dist-electron
desktop/resources/kin
dist
kin

# Tooling and docs not needed to compile.
.github
.vscode
.idea
docs
design
ios
tasks
execplan
*.md
!README.md

# OS noise.
.DS_Store
Thumbs.db
