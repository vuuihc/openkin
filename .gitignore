# OS
.DS_Store
Thumbs.db
.history

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python bytecode caches. `scripts/` has importable helper modules, and any
# `python3 scripts/...` run without `-B` writes one. The RSI gate rejects an
# unclean tree and only resets tracked files, so an unignored cache left by
# one gate run fails the next one.
__pycache__/

# Dependencies & build
node_modules
ui/dist/
build/
out/
target/
.turbo/
.next/
.cache/
*.tsbuildinfo

# Binary
/kin

# web/dist is Vite output (embedded via go:embed). Only the placeholder
# index.html is committed so `go build` compiles on a fresh clone; the hashed
# asset bundles are regenerated by `make build` / CI and must not be committed.
web/dist/assets/

# Logs & local data
*.log
logs/
.data/
data/local/
*.sqlite
*.sqlite3
*.db

# Agent / tool local state
.kin/
.claude/
.cursor/
.playwright-mcp/

# Xcode local state and build products
DerivedData/
*.xcuserstate
xcuserdata/

# Repository-local temporary build caches
.tmp/

# Python bytecode. `scripts/*.py` import sibling modules, so any run without
# `-B` (the RSI ratchet, a hand-run check) would otherwise leave the tree dirty
# and fail the merge gate's clean-tree check on the next run.
__pycache__/
*.pyc

# Maintainer working notes (not for public tree)
docs/working/

# Coverage & test
coverage/
.nyc_output/
.gstack/

# Dev stack local binary
.kin-dev/
nohup.out

# Per-machine dev code-signing identity (see scripts/dev-sign.sh)
.kin-codesign-identity

# APNs authentication keys, downloaded once from Apple. The node reads the key
# from the operator's keychain/settings, never from the repository.
*.p8

# Wrangler's local state, written by deploying relay/ (holds the account id)
relay/.wrangler/

# Local-only review pages with embedded screenshots (contain real machine data)
docs/plans/*.review.local.html
