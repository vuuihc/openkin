# Copy to .env and fill in. Docker Compose reads .env automatically.

# The public hostname of this Hub. It must resolve to the machine running
# Docker, with ports 80 and 443 forwarded to it. Let's Encrypt issues the
# certificate on first request, so this must be reachable from the internet
# before the console will load over HTTPS.
KIN_DOMAIN=kin.example.com

# Contact address for Let's Encrypt. Optional, but without it there is no
# warning before a certificate expires.
ACME_EMAIL=

# Pin the image to a released version instead of tracking latest.
# KIN_VERSION=0.1.0

# How long the Hub keeps an orphaned turn open waiting for a Node's connection
# to come back (default 5m; range 1s..1h). On a link that takes minutes to
# recover, a short grace fails turns the Node would have finished.
# KIN_NODE_RECONNECT_GRACE=5m

# --- GitHub / Google sign-in (optional) ----------------------------------
#
# Only needed when you layer docker-compose.oauth.yml on top:
#
#   docker compose -f docker-compose.yml -f docker-compose.oauth.yml up -d
#
# That file configures both providers. To offer only one, delete the other
# connector block from it and the two matching variables here: Dex validates
# every connector it is given, so a half-filled provider is a startup error.
#
# GitHub OAuth App — https://github.com/settings/developers
#   Homepage URL:               https://<KIN_DOMAIN>
#   Authorization callback URL: https://<KIN_DOMAIN>/dex/callback
#
# Google OAuth client, type "Web application" —
# https://console.cloud.google.com/apis/credentials
#   Authorized JavaScript origin: https://<KIN_DOMAIN>
#   Authorized redirect URI:      https://<KIN_DOMAIN>/dex/callback
#
# Google also requires a configured OAuth consent screen. While that screen is
# in "Testing", only accounts listed as test users can complete the flow.
#
# DEX_CLIENT_SECRET is a shared secret between Kin and Dex. It is never sent to
# either provider. Generate one with:  openssl rand -hex 32
#
# KIN_OIDC_DISPLAY_NAME is the login button's label; defaults to
# "GitHub / Google".
#
# Dex exchanges the OAuth code with the provider from inside its container, so
# the container itself must reach github.com and accounts.google.com. Containers
# do not inherit the Docker daemon's proxy settings; if this host needs one, set
# it here (Dex only — Kin talks to Dex over the Compose network):
#
# KIN_OAUTH_PROXY=http://192.168.1.10:7890
# KIN_OAUTH_NO_PROXY=localhost,127.0.0.1,dex,kin
#
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DEX_CLIENT_SECRET=
# KIN_OIDC_DISPLAY_NAME=
