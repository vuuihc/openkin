# Copy to .env and fill in. Docker Compose reads .env automatically.

# The public hostname of this Hub. It must resolve to the machine running
# Docker, with ports 80 and 443 forwarded to it. Let's Encrypt issues the
# certificate on first request, so this must be reachable from the internet
# before the console will load over HTTPS.
KIN_DOMAIN=kin.example.com

# Contact address for Let's Encrypt. Optional, but without it there is no
# warning before a certificate expires.
ACME_EMAIL=

# Pin the image to a released version instead of tracking latest.
# KIN_VERSION=0.1.0

# --- GitHub sign-in (optional) -------------------------------------------
#
# Only needed when you layer docker-compose.github.yml on top:
#
#   docker compose -f docker-compose.yml -f docker-compose.github.yml up -d
#
# Setup:
#   1. Create a GitHub OAuth App at https://github.com/settings/developers
#        Homepage URL:               https://<KIN_DOMAIN>
#        Authorization callback URL: https://<KIN_DOMAIN>/dex/callback
#   2. Fill in the three values below.
#
# DEX_CLIENT_SECRET is a shared secret between Kin and Dex. It is never sent to
# GitHub. Generate one with:  openssl rand -hex 32
#
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DEX_CLIENT_SECRET=
